<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="200.0" prefWidth="320.0" spacing="10" xmlns="http://javafx.com/javafx/18"
      xmlns:fx="http://javafx.com/fxml/1">
    <Label text="Connect to Battle Joker Server">
        <font>
            <Font size="15.0"/>
        </font>
    </Label>
    <TextField fx:id="nameField" alignment="CENTER" maxWidth="240" minWidth="240" promptText="Your name">
        <font>
            <Font size="17.0"/>
        </font>
    </TextField>
    <TextField fx:id="ipField" alignment="CENTER" maxWidth="240" minWidth="240" promptText="Server IP">
        <font>
            <Font size="15.0"/>
        </font>
    </TextField>
    <TextField fx:id="portField" alignment="CENTER" maxWidth="240" minWidth="240" promptText="Server port">
        <font>
            <Font size="15.0"/>
        </font>
    </TextField>
    <Button fx:id="goButton" text="GO!">
        <font>
            <Font size="15.0"/>
        </font>
    </Button>
</VBox>